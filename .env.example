# Copy to .env. Never put real credentials in this file.
OPENAI_API_KEY=
# Verified in official OpenAI documentation on 2026-10-07.
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=1000

# Agent Token, not a Relay Console session or organization key.
RELAY_AGENT_TOKEN=
# Origin only, without /v1. Must match the token's issuing environment.
RELAY_API_URL=https://api.relayapp.im
# Use the signing secret printed by relaymessenger listen --forward-to ...
RELAY_WEBHOOK_SECRET=
RELAY_TIMEOUT_SECONDS=10

# Local transport journal only; Supabase product data starts in Milestone 3.
INBOX_PATH=.runtime/inbox.sqlite3
WORKER_POLL_SECONDS=0.25
WORKER_MAX_ATTEMPTS=3
LOG_LEVEL=INFO
